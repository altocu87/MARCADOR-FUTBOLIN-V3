{
  "name": "marcador-futbolin-v3",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:engine": "tsx tests/matchEngine.test.ts",
    "test:persistence": "tsx tests/persistence.test.ts",
    "test:recovery": "tsx tests/recovery.test.ts",
    "test:offline": "tsx tests/offline.test.ts",
    "test:layout": "tsx tests/layout.test.tsx",
    "test:auth": "tsx tests/auth.test.ts && node --test tests/authEmails.test.mjs",
    "test:xp": "tsx --test tests/xp.test.ts",
    "test:elo": "tsx --test tests/elo.test.ts tests/competitionRepository.test.ts",
    "test:block04": "tsx --test tests/block04.test.ts",
    "test:statistics": "tsx --test tests/statistics.test.ts tests/playerAnalysis.test.ts",
    "test:browser": "npm run build && npm run build:test-offline && node --test tests/browser.test.mjs",
    "build:test-offline": "vite build --mode offline-test",
    "preview:test-offline": "vite preview --outDir tmp/pwa-test --host 127.0.0.1 --port 5188 --strictPort",
    "test": "npm run test:engine && npm run test:persistence && npm run test:recovery && npm run test:offline && npm run test:layout && npm run test:auth && npm run test:statistics && npm run test:xp && npm run test:elo && npm run test:block04"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "1.63.0",
    "tsx": "^4.23.15"
  }
}
